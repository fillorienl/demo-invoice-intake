# Copy to .env.local, fill in ONE provider, restart `npm run dev`.

# Which AI reads the invoices: anthropic | openai | mistral
LLM_PROVIDER=anthropic

# --- Claude (Anthropic) -------------------------------------------------------
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Any OpenAI-compatible API ------------------------------------------------
# Works with OpenAI, Azure OpenAI, Google Gemini, Ollama, LM Studio, OpenRouter, ...
# PDF pages are sent as images, so pick a model that accepts images.
OPENAI_API_KEY=
OPENAI_MODEL=
# Leave OPENAI_BASE_URL empty for OpenAI itself. Examples for the others:
#   Azure OpenAI:  https://YOUR-RESOURCE.openai.azure.com/openai/v1   (OPENAI_MODEL = your deployment name)
#   Google Gemini: https://generativelanguage.googleapis.com/v1beta/openai
#   Ollama:        http://localhost:11434/v1                           (no API key needed)
#   LM Studio:     http://localhost:1234/v1                            (no API key needed)
# OPENAI_BASE_URL=

# --- Mistral (EU-hosted) ------------------------------------------------------
# Uses Mistral OCR with a structured document annotation (max 8 pages per invoice).
MISTRAL_API_KEY=
# MISTRAL_OCR_MODEL=mistral-ocr-latest

# --- Testing without any AI ---------------------------------------------------
# "fixture" uses samples/expected/*.json instead of AI (bundled samples only). Shows a banner.
# EXTRACTOR=fixture